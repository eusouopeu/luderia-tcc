<mxfile host="app.diagrams.net">
  <diagram name="Limpeza Bloco A" id="limpeza-bloco-a">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Início -->
        <mxCell id="ini" value="Estabelecimento na fila de triagem&lt;br&gt;(bloco_b_triagem.csv)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- D0: fechado -->
        <mxCell id="d0" value="Google Maps indica&lt;br&gt;&lt;b&gt;fechado permanentemente&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="x0" value="&lt;b&gt;EXCLUÍDO&lt;/b&gt;&lt;br&gt;E0 · fechado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- P1: coleta de material -->
        <mxCell id="p1" value="Reunir fotos e publicações &lt;b&gt;dos últimos 24 meses&lt;/b&gt;&lt;br&gt;Google Maps · Instagram · site" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="280" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- D1: há material -->
        <mxCell id="d1" value="Há material&lt;br&gt;&lt;b&gt;do próprio local&lt;/b&gt;&lt;br&gt;em ao menos uma fonte?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="&lt;b&gt;EXCLUÍDO&lt;/b&gt;&lt;br&gt;E1 · sem evidência verificável" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="425" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- P2: checklist -->
        <mxCell id="p2" value="&lt;b&gt;Marcar cada evidência presente (1 ponto cada)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;A · Acervo&lt;/b&gt; — foto de estante com ≥ 2 jogos de caixa completa, fora da embalagem de venda&lt;br&gt;&lt;br&gt;&lt;b&gt;B · Uso&lt;/b&gt; — foto de jogo de caixa completa aberto sobre a mesa, em uso no local&lt;br&gt;&lt;br&gt;&lt;b&gt;C · Declaração&lt;/b&gt; — texto explícito no site, Instagram ou bio de que há jogos de cartas ou de tabuleiro disponíveis para uso no local" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="560" width="400" height="170" as="geometry" />
        </mxCell>

        <!-- D2: pontuação -->
        <mxCell id="d2" value="Pontuação&lt;br&gt;&lt;b&gt;≥ 2 de 3&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="770" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="&lt;b&gt;EXCLUÍDO&lt;/b&gt;&lt;br&gt;E2 · evidência insuficiente&lt;br&gt;(0 ou 1 ponto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="790" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="inc" value="&lt;b&gt;INCLUÍDO&lt;/b&gt;&lt;br&gt;I-AB · I-AC · I-BC · I-ABC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="920" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Registro -->
        <mxCell id="reg" value="Registrar em &lt;i&gt;evidencia_espaco_jogo&lt;/i&gt; o código (E0–E2 ou I-xx) e, em &lt;i&gt;observacao&lt;/i&gt;, o link de cada evidência" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="1020" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Nota de regras -->
        <mxCell id="nota" value="&lt;b&gt;Regras de leitura&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Uma foto só conta se for do próprio estabelecimento (não imagem de divulgação da editora).&lt;br&gt;&lt;br&gt;• B sozinho não basta: o jogo pode ter sido trazido pelo cliente.&lt;br&gt;&lt;br&gt;• A sozinho não basta: a estante pode ser só de venda.&lt;br&gt;&lt;br&gt;• C sozinho não basta: declaração sem prova visual.&lt;br&gt;&lt;br&gt;• Caso ambíguo: marcar a evidência como ausente e anotar a dúvida em &lt;i&gt;observacao&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="220" height="330" as="geometry" />
        </mxCell>

        <!-- Arestas -->
        <mxCell id="e1" edge="1" parent="1" source="ini" target="d0" style="endArrow=block;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="SIM" edge="1" parent="1" source="d0" target="x0" style="endArrow=block;html=1;strokeWidth=2;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="NÃO" edge="1" parent="1" source="d0" target="p1" style="endArrow=block;html=1;strokeWidth=2;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="p1" target="d1" style="endArrow=block;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="NÃO" edge="1" parent="1" source="d1" target="x1" style="endArrow=block;html=1;strokeWidth=2;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="SIM" edge="1" parent="1" source="d1" target="p2" style="endArrow=block;html=1;strokeWidth=2;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="p2" target="d2" style="endArrow=block;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="NÃO" edge="1" parent="1" source="d2" target="x2" style="endArrow=block;html=1;strokeWidth=2;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="SIM" edge="1" parent="1" source="d2" target="inc" style="endArrow=block;html=1;strokeWidth=2;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="inc" target="reg" style="endArrow=block;html=1;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="x0" target="reg" style="endArrow=block;html=1;dashed=1;strokeColor=#999999;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="940" y="180" /><mxPoint x="940" y="1060" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="x1" target="reg" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;exitX=1;exitY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="455" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="x2" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;exitX=1;exitY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="825" as="targetPoint" />
