.env
__pycache__/
*.pyc
.venv/
venv/
# Dados brutos: textos integrais, históricos e respostas de API não são publicados (_docs/_instrucoes/4_metodologia.md §3.4)
dados/*/_dados-brutos/**/*.jsonl
_src/pyScripts/*/4_logs/*.log
# Atalho (alias do macOS) para ~/Codigos/Apps/_shared, os padrões comuns aos apps; vale só nesta máquina
_src/_shared
# Bloco B4: arquivos originais grandes (microdados e agregados do Censo); regeneráveis pelos scripts de coleta
dados/B4_*/_dados-brutos/**/*.7z
dados/B4_*/_dados-brutos/**/*.zip
dados/B4_multiuso/_dados-brutos/caged/
dados/B4_multiuso/_auditoria/caged/
# Bloco B5: zip mensal do SINAPI (Caixa, 16 MB); regenerável pelo B5c_sinapi.py
dados/B5_reforma/_dados-brutos/sinapi/
.DS_Store
.tmp.driveupload/
.tmp.drivedownload/
# Bloco B1: curadoria manual e luderias aprovadas trazem texto de avaliações (_docs/_instrucoes/4_metodologia.md §3.4)
dados/B1_estabelecimentos/_dados-brutos/B1_curadoria_manual_*.xlsx
dados/B1_estabelecimentos/_dados-agregados/3_triagem/B1_aprovadas_*.xlsx
dados/B1_estabelecimentos/_dados-agregados/3_triagem/B1_comentarios_aprovadas_*.xlsx

# PDFs de terceiros baixados para leitura (direitos autorais; repositório público)
