.env
__pycache__/
*.pyc
.venv/
venv/
# Dados brutos: textos integrais, históricos e respostas de API não são publicados (_instrucoes/4_metodologia.md §3.4)
dados/*/_dados-brutos/**/*.jsonl
_src/*/*/logs/*.log
# Atalho (alias do macOS) para ~/Codigos/Apps/_shared, os padrões comuns aos apps; vale só nesta máquina
_src/_shared
# Bloco B4: arquivos originais grandes (microdados e agregados do Censo); regeneráveis pelos scripts de coleta
dados/\[B4\]*/_dados-brutos/**/*.7z
dados/\[B4\]*/_dados-brutos/**/*.zip
dados/\[B4\]*/_dados-brutos/caged/
.DS_Store
.tmp.driveupload/
.tmp.drivedownload/
# Bloco B1: curadoria manual e luderias aprovadas trazem texto de avaliações (_instrucoes/4_metodologia.md §3.4)
dados/\[B1\]*/_dados-brutos/B1_curadoria_manual_*.xlsx
dados/\[B1\]*/estabelecimentos/3_triagem/B1_aprovadas_*.xlsx
dados/\[B1\]*/estabelecimentos/3_triagem/B1_comentarios_aprovadas_*.xlsx

# PDFs de terceiros baixados para leitura (direitos autorais; repositório público)
bibliografia/leituras-*/*
!bibliografia/leituras-*/checklist-conceitos.md
bibliografia/bibliografia-v2/pdfs/
bibliografia/bibliografia-v2/amostras-sumarios/

# Bloco B1: cardápios originais (PDF, imagens, HTML de terceiros); só a transcrição em CSV é publicada
dados/\[B1\]*/_dados-brutos/cardapios/*
!dados/\[B1\]*/_dados-brutos/cardapios/transcricao/

# Bloco B3: fotos do app de observação (cardápio, estante: material de terceiros); só o texto transcrito é publicado
dados/\[B3\]*/_dados-brutos/app/fotos/

# Versões automáticas dos textos (mod tcc do Claude Code)
.tcc-historico/

# Arquivados: mesmas regras dos dados brutos (respostas de API e logs não são publicados)
arquivados/**/*.jsonl
arquivados/**/*.log

# Bloco B1: cardápios baixados em dados/[B1]… (PDF, imagens e prints de terceiros); só CSV e transcrições são publicados
dados/\[B1\]*/cardapios/**/*.pdf
dados/\[B1\]*/cardapios/**/*.png
dados/\[B1\]*/cardapios/**/*.jpg
dados/\[B1\]*/cardapios/**/*.jpeg
dados/\[B1\]*/cardapios/**/*.webp
dados/\[B1\]*/cardapios/*.pdf
# Modelo de idioma do Tesseract (OCR), baixado de tessdata_fast
_src/\[B1\]*/*/outros/tessdata/

# Bloco B1: páginas HTML do Acervo de Jogos (material de terceiros, cache da coleta); só os CSV são publicados
dados/\[B1\]*/_dados-brutos/acervodejogos/*.html
dados/\[B1\]*/_dados-brutos/acervodejogos/lojas/
dados/\[B1\]*/_dados-brutos/acervos_luderias/*/
dados/\[B1\]*/_dados-brutos/lojas_venda/

# Carregadores locais do Tampermonkey: caminho absoluto desta máquina (_src/extras/gerar_carregadores.py)
_src/extras/carregadores/

# Bloco B2: coletas do userscript e base consolidada trazem texto de avaliações (_instrucoes/4_metodologia.md §3.4); cobertura e fila são publicadas
dados/\[B2\]*/_dados-brutos/coletas/
dados/\[B2\]*/B2_avaliacoes_periodo.csv
dados/\[B2\]*/_dados-brutos/analise_conteudo/

# Cronograma: o .docx é gerado do .md quando for enviar (_src/extras/gerar_docx_cronograma.js)
textos/planejamento/cronograma_luderia*.docx
_src/extras/logs/

# Bloco B1: listas "seguindo" do Instagram e candidatos do snowball trazem @ de pessoas físicas (LGPD); só agregados e perfis de negócio são publicados
dados/\[B1\]*/_dados-brutos/redes_sociais/
_src/logs/
_src/Modelo financeiro/logs/*.log
